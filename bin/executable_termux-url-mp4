#!/data/data/com.termux/files/usr/bin/bash
# Downloads a URL as MP4 at the highest available quality. No menus.

# https://claude.ai/share/01010ea9-1a2b-4c74-9e36-f4e0323e6546

# --- Configuration ---
DOWNLOAD_DIR="$HOME/storage/downloads/termux/ytdlp_video"
mkdir -p "$DOWNLOAD_DIR"

# --- Colors ---
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NC='\033[0m'

url="$1"

if [ -z "$url" ]; then
    read -rp "$(echo -e "${YELLOW}Enter the URL to download: ${NC}")" url
    if [ -z "$url" ]; then
        echo -e "${RED} [!] No URL provided. Exiting.${NC}" >&2
        exit 1
    fi
fi

echo -e "${BLUE} [*] Downloading best-quality MP4 to: $DOWNLOAD_DIR${NC}"

if yt-dlp -f "bv*+ba/b" -t mp4 --output "$DOWNLOAD_DIR/%(title)s.%(ext)s" "$url"; then
    echo -e "${GREEN} [✓] Download complete.${NC}"
else
    echo -e "${RED} [!] Download failed.${NC}" >&2
    exit 1
fi
